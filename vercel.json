{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["cdg1"],
  "services": {
    "asl-recognition": { "root": ".", "entrypoint": "Dockerfile.vercel" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Permissions-Policy", "value": "camera=(self), microphone=()" }]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": { "type": "service", "service": "asl-recognition" } }
  ]
}
